            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not savedCoordsInstan[i] then
                    savedCoordsInstan[i] = hrp.CFrame
                    WindUI:Notify({ Title = "Teleport Instan", Content = "Position " .. i .. " Saved!", Duration = 2 })
                else
                    hrp.CFrame = savedCoordsInstan[i]
