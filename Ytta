local Window = Rayfield:CreateWindow({
   Name = "KyZen HUB",
   LoadingTitle = "Memuat KyZen HUB...",
   LoadingSubtitle = "Universal Script",
   ConfigurationSaving = {
      Enabled = false,
      FolderName = nil,
