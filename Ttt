   },
   KeySystem = false,
   KeySettings = {
      Title = "Key System",
      Subtitle = "Masukkan Key",
      Note = "Dapatkan key di...",
      FileName = "KyZenKey",
      SaveKey = true,
      GrabKeyFromSite = false,
      Key = {"1234"}
   }
})

-- ==========================================
-- MEMBUAT TAB MENU
-- ==========================================
local HomeTab = Window:CreateTab({ name = "HOME", icon = "home" })
local InfoTab = Window:CreateTab({ name = "INFORMASI", icon = "info" })
local PlayerTab = Window:CreateTab({ name = "PLAYER", icon = "user" })
local VisualTab = Window:CreateTab({ name = "VISUAL", icon = "eye" })
local CombatTab = Window:CreateTab({ name = "COMBAT", icon = "crosshair" })
local MovementTab = Window:CreateTab({ name = "MOVEMENT", icon = "activity" })
local WorldTab = Window:CreateTab({ name = "WORLD", icon = "globe" })
local TrollFETab = Window:CreateTab({ name = "TROLL FE", icon = "smile" })
local UtilityTab = Window:CreateTab({ name = "UTILTY PREMIUM", icon = "star" })

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- 1. HOME
-- ==========================================
HomeTab:CreateSection("Informasi Akun & Game")
HomeTab:CreateParagraph({ title = "Status User", content = "Username: " .. LocalPlayer.Name .. "\nDisplay Name: " .. LocalPlayer.DisplayName .. "\nPlaceId: " .. game.PlaceId .. "\nJobId: " .. game.JobId })

HomeTab:CreateSection("Kontrol Utama")
HomeTab:CreateButton({
   name = "Destroy UI (Tutup Hub)",
   callback = function()
      Rayfield:Destroy()
   end,
})

-- ==========================================
-- 2. INFORMASI
-- ==========================================
InfoTab:CreateSection("Panduan & Kegunaan Fitur")
InfoTab:CreateParagraph({ 
   title = "Daftar Penjelasan Menu", 
   content = [[• HOME: Menampilkan data akun, server ID, serta tombol untuk menutup total hub jika ada admin.
• PLAYER: Mengatur kecepatan (WalkSpeed), tinggi lompatan (JumpPower), Infinite Jump, Noclip (tembus tembok), dan Anti-AFK.
• VISUAL: Berisi Fullbright + No Fog, FOV Slider, dan X-Ray dinding transparan.
• COMBAT: Fitur pertarungan seperti Aimbot Universal, Team Check, Hitbox Expander, dan Silent Aim.
• MOVEMENT: Alat bantu mobilitas seperti Click TP (CTRL + Klik).
• WORLD: Fitur dunia seperti FPS Booster (anti lag), Server Hop, dan Rejoin / Copy JobId.
• TROLL FE: Berisi fungsi server-sided untuk mengerjai pemain lain (Invisible FE, Fling All).
