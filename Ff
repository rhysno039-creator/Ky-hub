-- 11. Anti Kick
PlayerTab:Toggle({
    Title = "Anti Kick", 
    Default = false, 
    Callback = function(V)
        _G.AntiKick = V
        if V then
            pcall(function()
                local mt = getrawmetatable(game)
                setreadonly(mt, false)
                local old = mt.__namecall
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if _G.AntiKick and (method == "Kick" or method == "kick") then
                        return
                    end
                    return old(self, ...)
                end)
                setreadonly(mt, true)
            end)
        end
    end
})


