ESPFolder.Parent = workspace

local function createESP(target, textContent, color)
    if not target:FindFirstChild("Head") and not target:FindFirstChild("HumanoidRootPart") then return end
    local part = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
    
    if part:FindFirstChild("KyZenESPTag") then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "KyZenESPTag"
    billboard.Size = UDim2.new(0, 100, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = part
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = textContent
    textLabel.TextColor3 = color
    textLabel.TextScaled = false
    textLabel.TextSize = 13
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextStrokeTransparency = 0
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Parent = billboard
end

local function removeESP(target)
    if target:FindFirstChild("Head") then
        local tag = target.Head:FindFirstChild("KyZenESPTag")
        if tag then tag:Destroy() end
    end
    if target:FindFirstChild("HumanoidRootPart") then
        local tag = target.HumanoidRootPart:FindFirstChild("KyZenESPTag")
        if tag then tag:Destroy() end
    end
end

