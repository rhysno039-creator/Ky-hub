        local tickTime = tick() * 5
        local rainbowColor = Color3.fromHSV(tickTime % 1, 1, 1)

        -- Rainbow Tracers Logic
        if rainbowTracersEnabled and Drawing then
            removeTracers()
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHrp = p.Character.HumanoidRootPart
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetHrp.Position)
                    if onScreen then
                        local line = Drawing.new("Line")
                        line.Visible = true
                        line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(screenPos.X, screenPos.Y)
                        line.Color = rainbowColor
                        line.Thickness = 1.5
                        line.Transparency = 0.8
                        table.insert(tracersList, line)
                    end
                end
            end
        end

        -- Fling All Logic
        if flingAllEnabled then
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHrp then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        p.Character.HumanoidRootPart.Velocity = Vector3.new(99999, 99999, 99999)
                    end
                end
            end
        end

        -- ESP Highlights
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local char = p.Character
                local highlight = char:FindFirstChild("KyZenRainbowHighlight")
                
                if (espEnabled or chamsEspEnabled or rainbowSkeletonEnabled) then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "KyZenRainbowHighlight"
                        highlight.Parent = char
                    end
                    highlight.Enabled = true
                    highlight.FillColor = rainbowColor
                    highlight.OutlineColor = rainbowColor
                    highlight.FillTransparency = chamsEspEnabled and 0.5 or 1
                    highlight.OutlineTransparency = 0
                else
                    if highlight then highlight:Destroy() end
                end
            end
        end

        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if flyToggled and hrp and bodyVelocity and bodyGyro then
            bodyGyro.CFrame = Camera.CFrame
            local moveDirection = hum.MoveDirection
            local ySpeed = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then ySpeed = flySpeed end
            bodyVelocity.Velocity = (Camera.CFrame.LookVector * (moveDirection.Magnitude > 0 and flySpeed or 0)) + Vector3.new(0, ySpeed, 0)
        end
        if walkSpeedEnabled and hum then hum.WalkSpeed = customWalkSpeed end
        if jumpPowerEnabled and hum then hum.JumpPower = customJumpPower end
        if dashSpeedEnabled and hum and hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (dashSpeedVal / 50))
        end
        if bunnyHopEnabled and hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        if noclipEnabled then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
        if fullBrightEnabled then Lighting.Brightness = brightLevelValue Lighting.GlobalShadows = false end
        if fovEnabled then Camera.FieldOfView = fovValue end
    end)
end)

