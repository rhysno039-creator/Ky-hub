-- Fungsi Helper untuk Membuat Kotak Search & Laci Pengaturan di Setiap Menu
local function setupTabMenu(tab, tabName)
    -- Fitur Search di dalam Tab
    tab:Input({
        Title = "Cari di " .. tabName,
        Icon = "search",
        Placeholder = "Ketik fitur...",
        Value = "",
        Callback = function(v)
            local query = string.lower(v)
            if query ~= "" then
                WindUI:Notify({
                    Title = "Pencarian (" .. tabName .. ")",
                    Content = "Mencari: " .. v,
                    Duration = 2
                })
            end
        end
    })

    -- Laci Pengaturan (Collapsible Folder) yang bisa dilipat/dibuka
    local settingsDrawer = tab:Folder({
        Title = "Laci Pengaturan " .. tabName,
        Opened = false -- Status awal tertutup (dilipat) seperti laci
    })

    settingsDrawer:Paragraph({
        Title = "Informasi Laci",
        Desc = "Fitur-fitur " .. tabName .. " tersimpan di dalam laci ini. Klik untuk melipat atau membukanya kembali."
    })

    settingsDrawer:Button({
        Title = "Contoh Tombol Fitur",
        Desc = "Tombol uji coba di dalam laci",
        Callback = function()
            WindUI:Notify({
                Title = tabName,
                Content = "Fitur di dalam laci berhasil diaktifkan!",
                Duration = 2
            })
        end
    })
end

