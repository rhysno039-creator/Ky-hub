-- ==================== TAB 3: PLAYER ====================
local flyToggled = false
local flySpeed = 50
local bodyVelocity, bodyGyro

local PlayerTab = Window:Tab({ Title = "Player", Icon = "user" })
PlayerTab:Section({ Title = "1. Kontrol Utama" })
PlayerTab:Toggle({
    Title = "Fly", Default = false, 
    Callback = function(V) 
        flyToggled = V
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if flyToggled and hrp and hum then
            hum.PlatformStand = true
            bodyVelocity = Instance.new("BodyVelocity", hrp)
            bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyGyro = Instance.new("BodyGyro", hrp)
            bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyGyro.P = 20000
            bodyGyro.CFrame = Camera.CFrame
        else
            if hum then hum.PlatformStand = false end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
        end
    end
})
PlayerTab:Input({
    Title = "Fly Speed", Default = "50", Placeholder = "Masukkan angka...", 
    Callback = function(val) local num = tonumber(val) if num then flySpeed = num end end
})


