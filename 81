TeleportTab:Section({ Title = "Teleport RUN (Saved)" })
TeleportTab:Input({
    Title = "Run Speed Control", Default = "50", Placeholder = "Enter run teleport speed...",
    Callback = function(val)
        local num = tonumber(val)
        if num then runTeleportSpeed = num end
    end
})

for i = 1, 5 do
    TeleportTab:Button({
        Title = i .. " - Save | Run",
        Callback = function()
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if not savedCoordsRun[i] then
                    savedCoordsRun[i] = hrp.CFrame
                    WindUI:Notify({ Title = "Teleport RUN", Content = "Run Position " .. i .. " Saved!", Duration = 2 })
                else
                    local targetCFrame = savedCoordsRun[i]
                    local startPos = hrp.Position
                    local endPos = targetCFrame.Position
                    local distance = (endPos - startPos).Magnitude
                    local duration = distance / math.max(runTeleportSpeed, 1)
                    local startTime = tick()
                    
                    task.spawn(function()
                        while tick() - startTime < duration do
                            local alpha = (tick() - startTime) / duration
                            if hrp and hrp.Parent then
                                hrp.CFrame = CFrame.new(startPos:Lerp(endPos, alpha))
                            else
                                break
                            end
                            task.wait()
                        end
                        if hrp and hrp.Parent then
                            hrp.CFrame = targetCFrame
                        end
                    end)
                    WindUI:Notify({ Title = "Teleport RUN", Content = "Running to Position " .. i, Duration = 2 })
                end
            end
        end
    end
end

