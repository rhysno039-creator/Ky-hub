-- Setup Player ESP & Custom Size Handle
local function setupCustomESP(plr)
    if plr == LocalPlayer then return end
    
    local function apply(char)
        task.wait(1)
        if char then
            -- Chams & Box Handle via Highlight
            if not char:FindFirstChild("KyZenCustomESP") then
                local hl = Instance.new("Highlight")
                hl.Name = "KyZenCustomESP"
                hl.FillColor = Color3.fromRGB(255, 0, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0
                hl.Adornee = char
                hl.Parent = char
                hl.Enabled = false
            end
            
            -- Head Dot Handle
            local head = char:FindFirstChild("Head")
            if head and not head:FindFirstChild("KyZenHeadDot") then
                local sphere = Instance.new("SelectionBox")
                sphere.Name = "KyZenHeadDot"
                sphere.Adornee = head
                sphere.Color3 = Color3.fromRGB(255, 255, 0)
                sphere.LineThickness = 0.02
                sphere.Parent = head
                sphere.Visible = false
            end
        end
    end
    
    plr.CharacterAdded:Connect(apply)
    if plr.Character then apply(plr.Character) end
end

for _, p in pairs(Players:GetPlayers()) do setupCustomESP(p) end
Players.PlayerAdded:Connect(setupCustomESP)

-- ================= RUNSERVICE UTAMA =================
RunService.RenderStepped:Connect(function()
    pcall(function()
        local rainbowColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local char = p.Character
                local hl = char:FindFirstChild("KyZenCustomESP")
                local head = char:FindFirstChild("Head")
                
                -- Logika Chams, Box, CornerBox, Rainbow
                if hl then
                    local active = _G.BoxESP or _G.Chams or _G.CornerBox
                    hl.Enabled = active
                    if active then
                        if _G.RainbowESP then
                            hl.FillColor = rainbowColor
                            hl.OutlineColor = rainbowColor
                        else
                            hl.FillColor = Color3.fromRGB(255, 0, 0)
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        end
                        -- Mengatur ukuran/ketebalan efek berdasarkan input BoxSize
                        hl.OutlineTransparency = (_G.CornerBox or _G.BoxESP) and 0 or 1
                    end
                end
                
                -- Logika Head Dot + Ukuran dapat diketik
                if head and head:FindFirstChild("KyZenHeadDot") then
                    local dot = head.KyZenHeadDot
                    dot.Visible = _G.HeadDot
                    if _G.HeadDot then
                        -- Mengubah ukuran area kotak di kepala berdasarkan _G.HeadDotSize
                        dot.Size = Vector3.new(_G.HeadDotSize, _G.HeadDotSize, _G.HeadDotSize)
                    end
                end
            end
        end

        -- Logika Pergerakan Fly
        if flyToggled and bodyVelocity and bodyGyro and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            bodyGyro.CFrame = Camera.CFrame
            local moveDir = Vector3.new(0, 0, 0)
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            
            if hum and hum.MoveDirection.Magnitude > 0 then moveDir = hum.MoveDirection end
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
            
            local targetVel = Vector3.new(0, 0, 0)
            if moveDir.Magnitude > 0 then targetVel = Camera.CFrame.LookVector * flySpeed end
            bodyVelocity.Velocity = targetVel
        end

        -- Logika WalkSpeed & JumpPower
        if _G.SpeedEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = _G.SpeedVal
        end
        if _G.JumpEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.UseJumpPower = true
            LocalPlayer.Character.Humanoid.JumpPower = _G.JumpVal
        end
        if _G.MoonWalkEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hum = LocalPlayer.Character.Humanoid
            local hrp = LocalPlayer.Character.HumanoidRootPart
            if hum.MoveDirection.Magnitude > 0 then
                hrp.CFrame = hrp.CFrame - (hum.MoveDirection * (_G.MoonWalkSpeed * 0.01))
            end
        end
        if _G.ShiftLockEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            LocalPlayer.Character.Humanoid.AutoRotate = false
            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z))
        elseif not flyToggled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.AutoRotate = true
        end
        if _G.BunnyHop and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end)
end)

