-- 5. Anti Void (Simpan Posisi Tempat Aman Terakhir + Teleport Balik)
local antiVoidEnabled = false
local lastSafePos = nil
PlayerTab:Toggle({
    Title = "Anti Void [ON/OFF]",
    Callback = function(v) antiVoidEnabled = v end
})
rs.Heartbeat:Connect(function()
    local char = plr.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        local hum = char:FindFirstChild("Humanoid")
        
        if hum and hum.FloorMaterial ~= Enum.Material.Air then
            lastSafePos = hrp.CFrame
        end

        if antiVoidEnabled and hrp.Position.Y < -50 then
            if lastSafePos then
                hrp.CFrame = lastSafePos
            else
                hrp.CFrame = CFrame.new(hrp.Position.X, 50, hrp.Position.Z)
            end
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end
end)

