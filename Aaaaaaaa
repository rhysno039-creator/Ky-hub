-- ==================== LOOP RUNTIME GLOBAL ====================
RunService.RenderStepped:Connect(function()
    pcall(function()
        -- Logika Spectate
        if spectateEnabled and selectedSpectateTarget then
            local targetPlayer = Players:FindFirstChild(selectedSpectateTarget)
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid") then
                Camera.CameraSubject = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            end
        end

        local tickTime = tick() * 5
        local rainbowColor = Color3.fromHSV(tickTime % 1, 1, 1)

        -- Loop untuk fitur Visual/ESP player lain
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local char = p.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                
                -- 1. Rainbow Hitbox ESP
                if rainbowHitboxEnabled and hrp then
                    hrp.Size = Vector3.new(hitboxSizeValue, hitboxSizeValue, hitboxSizeValue)
                    hrp.Transparency = 0.5
                    hrp.Color = rainbowColor
                    hrp.CanCollide = false
                end

                -- 2. Rainbow ESP & Chams (Highlight Effect)
                local highlight = char:FindFirstChild("KyZenHighlight")
                if (rainbowEspEnabled or rainbowChamsEspEnabled) then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "KyZenHighlight"
                        highlight.Parent = char
                    end
                    highlight.Enabled = true
                    highlight.FillColor = rainbowColor
                    highlight.OutlineColor = rainbowColor
                    highlight.FillTransparency = rainbowChamsEspEnabled and 0.5 or 1
                    highlight.OutlineTransparency = 0
                else
                    if highlight then highlight:Destroy() end
                end

                -- 3. Rainbow Health ESP
                local head = char:FindFirstChild("Head")
                local hum = char:FindFirstChild("Humanoid")
                local billboard = head and head:FindFirstChild("KyZenHealthESP")
                if rainbowHealthEspEnabled and head and hum then
                    if not billboard then
                        billboard = Instance.new("BillboardGui")
                        billboard.Name = "KyZenHealthESP"
                        billboard.Size = UDim2.new(0, 100, 0, 40)
                        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                        billboard.AlwaysOnTop = true
                        billboard.Parent = head

                        local textLabel = Instance.new("TextLabel")
                        textLabel.Name = "HealthText"
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.TextScaled = true
                        textLabel.Font = Enum.Font.SourceSansBold
                        textLabel.Parent = billboard
                    end
                    local textLabel = billboard:FindFirstChild("HealthText")
                    if textLabel then
                        textLabel.Text = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
                        textLabel.TextColor3 = rainbowColor
                    end
                else
                    if billboard then billboard:Destroy() end
                end
            end
        end

        -- Loop untuk fitur Player & Environment lainnya
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if flyToggled and hrp and bodyVelocity and bodyGyro then
            bodyGyro.CFrame = Camera.CFrame
            local moveDirection = hum.MoveDirection
            local ySpeed = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then ySpeed = flySpeed end
            bodyVelocity.Velocity = (Camera.CFrame.LookVector * (moveDirection.Magnitude > 0 and flySpeed or 0)) + Vector3.new(0, ySpeed, 0)
        end
        if walkSpeedEnabled and hum then hum.WalkSpeed = customWalkSpeed end
        if jumpPowerEnabled and hum then hum.JumpPower = customJumpPower end
        if bunnyHopEnabled and hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        if noclipEnabled then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
        if fullBrightEnabled then Lighting.Brightness = brightLevelValue Lighting.GlobalShadows = false end
        if fovEnabled then Camera.FieldOfView = fovValue end
    end)
end)

