local function UpdatePlayerList()
    PlayerNamesList = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(PlayerNamesList, p.Name) end
    end
end
UpdatePlayerList()

TrollFETab:Dropdown({
    Title = "Pilih Target Player",
    Values = PlayerNamesList,
    Default = 1,
    Callback = function(Option) SelectedTargetPlayer = Option end
})

TrollFETab:Button({
    Title = "Refresh List Player",
    Callback = function()
        UpdatePlayerList()
        WindUI:Notify({ Title = "Troll", Content = "Daftar player diperbarui!", Duration = 2 })
    end
})

TrollFETab:Button({
    Title = "Bring (Tarik player ke lu)",
    Callback = function()
        if SelectedTargetPlayer then
            local target = Players:FindFirstChild(SelectedTargetPlayer)
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
