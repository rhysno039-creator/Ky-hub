PlayerTab:Button({
    Title = getText("CopyAvatar"),
    Callback = function()
        if selectedAvatarTarget and selectedAvatarTarget ~= "Tidak ada player" then
            local targetP = Players:FindFirstChild(selectedAvatarTarget)
            if targetP and targetP.Character and LocalPlayer.Character then
                pcall(function()
                    local targetHum = targetP.Character:FindFirstChildOfClass("Humanoid")
                    local myHum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if targetHum and myHum then
                        local desc = targetHum:GetAppliedDescription()
                        myHum:ApplyDescription(desc)
                        WindUI:Notify({ Title = "Berhasil", Content = "Avatar berhasil disalin!", Duration = 3 })
                    end
                end)
            end
        end
    end
