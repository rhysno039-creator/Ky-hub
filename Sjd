-- TAB 2: PLAYER
local flyToggled = false
local flySpeed = 50
local bodyVelocity, bodyGyro
local noclipEnabled = false
local bunnyHopEnabled = false
local infJumpEnabled = false
local airPlatformEnabled = false
local airPlatformPart = nil

local freecamEnabled = false
local freecamSpeed = 50
local freecamPart = nil

local antiAfkConnection = nil
local antiRejoinConnection = nil

local runTabEnabled = false
local customRunSpeed = 24
local jumpPowerEnabled = false
local customJumpPower = 50

local PlayerTab = Window:Tab({ Title = "Player", Icon = "user" })
PlayerTab:Section({ Title = "⚡ Movement & Flight Controls" })
PlayerTab:Toggle({
    Title = "Fly Mode", Default = false, 
    Callback = function(V) 
        flyToggled = V
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if flyToggled and hrp and hum then
            hum.PlatformStand = true
            bodyVelocity = Instance.new("BodyVelocity", hrp)
            bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyGyro = Instance.new("BodyGyro", hrp)
            bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyGyro.P = 20000
            bodyGyro.CFrame = Camera.CFrame
        else
            if hum then hum.PlatformStand = false end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
        end
    end
})
PlayerTab:Input({
    Title = "Fly Speed Value", Default = "50", Placeholder = "Enter fly speed...", 
    Callback = function(val) local num = tonumber(val) if num then flySpeed = num end end
})

PlayerTab:Section({ Title = "🏃 Speed & Jumping Enhancements" })
PlayerTab:Toggle({
    Title = "Custom Walk Speed", Default = false,
    Callback = function(state)
        runTabEnabled = state
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = state and customRunSpeed or 16 end
    end
})
PlayerTab:Input({
    Title = "Walk Speed Value", Default = "24", Placeholder = "Enter speed number...",
    Callback = function(val) local num = tonumber(val) if num then customRunSpeed = num end end
})

PlayerTab:Toggle({
    Title = "Custom Jump Power", Default = false,
    Callback = function(state)
        jumpPowerEnabled = state
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then hum.UseJumpPower = state hum.JumpPower = state and customJumpPower or 50 end
    end
})
PlayerTab:Input({
    Title = "Jump Power Value", Default = "50", Placeholder = "Enter jump power...",
    Callback = function(val) local num = tonumber(val) if num then customJumpPower = num end end
})

PlayerTab:Toggle({ 
    Title = "Noclip", Default = false, 
    Callback = function(state) noclipEnabled = state end 
})
PlayerTab:Toggle({ 
    Title = "Infinite Jump", Default = false, 
    Callback = function(state) infJumpEnabled = state end 
})

PlayerTab:Section({ Title = "🛡️ Safety & Anti-Ban Protection" })
PlayerTab:Button({
    Title = "Respawn Character",
    Callback = function()
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.Health = 0
            end
        end)
    end
})

PlayerTab:Toggle({ 
    Title = "Anti AFK", Default = false, 
    Callback = function(state) 
        if state then
            local vu = game:GetService("VirtualUser")
            antiAfkConnection = LocalPlayer.Idled:Connect(function()
                vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                task.wait(1)
                vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            end)
        else
            if antiAfkConnection then antiAfkConnection:Disconnect() end
        end
    end 
})

UserInputService.JumpRequest:Connect(function()
    if infJumpEnabled then
        pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
    end
end)

-- TAB 3: VISUAL / ESP
local VisualTab = Window:Tab({ Title = "Visual", Icon = "eye" })
local espEnabled = false
local fullBrightEnabled = false
local brightLevelValue = 2
local espGuiList = {}

local function clearEspGuis()
    for _, gui in pairs(espGuiList) do
        pcall(function() gui:Destroy() end)
    end
    espGuiList = {}
end

VisualTab:Section({ Title = "ESP & Environment" })
VisualTab:Toggle({
    Title = "ESP Box (Name & Distance)", Default = false, 
    Callback = function(state) 
        espEnabled = state 
        if not state then clearEspGuis() end
    end
})

VisualTab:Toggle({
    Title = "Full Brightness", Default = false,
    Callback = function(state)
        fullBrightEnabled = state
        if not state then Lighting.Brightness = 1 Lighting.GlobalShadows = true end
    end
})

