WorldTab:Toggle({
    Title = "FPS Booster & Anti Lag On/Off",
    Default = false,
    Callback = function(Value)
        if Value then
            for _, e in pairs(workspace:GetDescendants()) do
                if e:IsA("ParticleEmitter") or e:IsA("Trail") or e:IsA("Smoke") then e.Enabled = false end
            end
            WindUI:Notify({ Title = "FPS Booster", Content = "Efek partikel dimatikan.", Duration = 2 })
        else
            for _, e in pairs(workspace:GetDescendants()) do
                if e:IsA("ParticleEmitter") or e:IsA("Trail") or e:IsA("Smoke") then e.Enabled = true end
            end
            WindUI:Notify({ Title = "FPS Booster", Content = "Efek partikel diaktifkan kembali.", Duration = 2 })
        end
    end
})

WorldTab:Button({
    Title = "Server Hop",
    Callback = function()
        local Http = game:GetService("HttpService")
        local TPS = game:GetService("TeleportService")
        local Servers = Http:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
        for _, s in pairs(Servers.data) do
            if s.playing < s.maxPlayers then
                TPS:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                break
            end
        end
    end
})

WorldTab:Button({
