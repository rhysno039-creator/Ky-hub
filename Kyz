-- Remote Networker Handler
local NetworkerClient = nil
pcall(function()
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    if packages then
        local networker = packages:FindFirstChild("Networker")
        if networker then
            NetworkerClient = require(networker:FindFirstChild("NetworkerClient"))
        end
    end
end)

local function fireRemote(actionName, ...)
    pcall(function()
        if NetworkerClient and type(NetworkerClient) == "table" and NetworkerClient.Fire then
            NetworkerClient:Fire(actionName, ...)
        else
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            if remotes and remotes:FindFirstChild(actionName) then
                remotes[actionName]:FireServer(...)
            end
        end
    end)
end

