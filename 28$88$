PlayerTab:Section({ Title = "Fly V5 - Kamera System" })

local plr = game.Players.LocalPlayer
local rs = game:GetService("RunService")
local bv,bg,conn
local flySpeed = 35

local function StartFly(speed)
    -- FLY NO TOLERANSI (AUTO KICK JIKA > 500)
    if speed > 500 then
        plr:Kick("\n\n🛡️ [KYZEN HUB - SECURITY] 🗿\n\nWoy kebanyakan gaya lu!\nLimit cuma 500, lu ketik "..speed.."\n\nJangan ngotak-ngatik, nanti meledak HP lu!\n\nAuto kick by Kyzen System")
        return
    end
    
    local char = plr.Character
    if not char then return end
    local hrp = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    local cam = workspace.CurrentCamera
    hum.PlatformStand = true

    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9,9e9,9e9)
    bv.Velocity = Vector3.new(0,0,0)
    bv.Parent = hrp

    bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(9e9,9e9,9e9)
    bg.D = 15
    bg.P = 5000
    bg.Parent = hrp

    conn = rs.Heartbeat:Connect(function()
        if hrp.Anchored then hrp.Anchored = false end
        local move = hum.MoveDirection 
        local camCF = cam.CFrame

        if move.Magnitude > 0.01 then 
            local vel = (camCF.LookVector * move.Z + camCF.RightVector * move.X) * speed
            if move.Z < 0 then
                vel = (camCF.LookVector * -move.Z + camCF.RightVector * move.X) * speed
            else
                vel = (camCF.LookVector * -move.Z + camCF.RightVector * move.X) * speed * 0.7
            end
            bv.Velocity = bv.Velocity:Lerp(vel, 0.35)
        else
            bv.Velocity = bv.Velocity:Lerp(Vector3.new(0,0,0), 0.25)
        end
        bg.CFrame = bg.CFrame:Lerp(camCF, 0.35)
    end)
end

local function StopFly()
    local char = plr.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        for _,v in pairs(char.HumanoidRootPart:GetChildren()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
        end
    end
    if conn then conn:Disconnect() end
end

