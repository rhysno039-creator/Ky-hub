local PlayerTab = Window:Tab({ Title = "Player", Icon = "user" })

-- Variabel Pendukung Fitur
local flyToggled = false
local flySpeed = 50
local bodyVelocity, bodyGyro
local customWalkSpeed = 16

-- 1. Moon Walk (Sesuai permintaanmu, terpisah dari Walk Speed)
PlayerTab:Toggle({Title = "Moon Walk", Default = false, Callback = function(V) _G.MoonWalkEnabled = V end})

-- 2. Shift Lock
