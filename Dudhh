local PlayerTab = Window:Tab({ Title = "Player", Icon = "user" })

-- Variabel Pendukung
local flyToggled = false
local flySpeed = 50
local bodyVelocity, bodyGyro
local walkSpeedEnabled = false
local customWalkSpeed = 16
local moonWalkEnabled = false
local moonWalkSpeed = 16

-- ==================== 1. KONTROL UTAMA (FLY & WALK SPEED) ====================
PlayerTab:Section({ Title = "1. Kontrol Utama (Fly & Kecepatan)" })

PlayerTab:Paragraph({ 
    Title = "🚀 Pengaturan Fly & Speed", 
    Desc = "Pengaturan fitur terbang utama dan kecepatan karakter." 
})

PlayerTab:Toggle({
    Title = "Fly", 
    Default = false, 
    Callback = function(V) 
        flyToggled = V
        _G.FlyEnabled = V
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        
        if flyToggled and hrp and hum then
            hum.PlatformStand = true
            bodyVelocity = Instance.new("BodyVelocity", hrp)
            bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyGyro = Instance.new("BodyGyro", hrp)
            bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyGyro.P = 20000
            bodyGyro.CFrame = Camera.CFrame
        else
            if hum then hum.PlatformStand = false end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
        end
    end
})

PlayerTab:Input({
    Title = "Fly Speed", 
    Default = "50", 
    Placeholder = "Masukkan angka...", 
    Callback = function(val) 
        local num = tonumber(val)
        if num then flySpeed = num end
    end
})

PlayerTab:Toggle({
    Title = "Walk Speed", 
    Default = false, 
    Callback = function(V) 
        walkSpeedEnabled = V 
        _G.SpeedEnabled = V 
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then
            hum.WalkSpeed = V and customWalkSpeed or 16
        end
    end
})

PlayerTab:Input({
    Title = "Walk Speed",
    Default = "16",
    Placeholder = "Contoh: 8 atau 35",
    Callback = function(value)
        local num = tonumber(value)
        if num then
            customWalkSpeed = num
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
            if walkSpeedEnabled and hum then
                hum.WalkSpeed = customWalkSpeed
            end
        end
    end
})


