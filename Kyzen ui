-- Fungsi untuk membuat Tab
local currentTabContent = nil

local function createTabContent(tabName)
    if currentTabContent then currentTabContent:Destroy() end
    
    currentTabContent = Instance.new("ScrollingFrame")
    currentTabContent.Parent = ContentArea
    currentTabContent.BackgroundTransparency = 1
    currentTabContent.Size = UDim2.new(1, 0, 1, 0)
    currentTabContent.CanvasSize = UDim2.new(0, 0, 0, 800)
    currentTabContent.ScrollBarThickness = 4
    
    local UIList = Instance.new("UIListLayout")
    UIList.Parent = currentTabContent
    UIList.SortOrder = Enum.SortOrder.LayoutOrder
    UIList.Padding = UDim.new(0, 10)
    
    if tabName == "Info" then
        -- Panel Info & Saturn Image Card
        local InfoBox = Instance.new("Frame")
        InfoBox.Parent = currentTabContent
        InfoBox.BackgroundColor3 = Color3.fromRGB(20, 28, 42)
        InfoBox.Size = UDim2.new(1, -10, 0, 150)
        
        local BoxCorner = Instance.new("UICorner")
        BoxCorner.CornerRadius = UDim.new(0, 6)
        BoxCorner.Parent = InfoBox
        
        local InfoText = Instance.new("TextLabel")
        InfoText.Parent = InfoBox
        InfoText.BackgroundTransparency = 1
        InfoText.Position = UDim2.new(0, 15, 0, 15)
        InfoText.Size = UDim2.new(1, -30, 1, -30)
        InfoText.Font = Enum.Font.Gotham
        InfoText.Text = "Welcome KYZEN\nKYZENKIO IS BACK\nStatus: 28229 members | 001 online\n\n[ Saturn Tech Theme Active ]"
        InfoText.TextColor3 = Color3.fromRGB(200, 230, 255)
        InfoText.TextSize = 13
        InfoText.TextXAlignment = Enum.TextXAlignment.Left
        InfoText.TextYAlignment = Enum.TextYAlignment.Top

    elseif tabName == "Movement" then
        -- Label Judul Movement
        local Title = Instance.new("TextLabel")
        Title.Parent = currentTabContent
        Title.BackgroundTransparency = 1
        Title.Size = UDim2.new(1, -10, 0, 30)
        Title.Font = Enum.Font.GothamBold
        Title.Text = "--- MOVEMENT SETTINGS ---"
        Title.TextColor3 = Color3.fromRGB(0, 220, 255)
        Title.TextSize = 14

        -- 1. Fly Speed Input & Toggle
        local FlyBox = Instance.new("TextBox")
        FlyBox.Parent = currentTabContent
        FlyBox.BackgroundColor3 = Color3.fromRGB(25, 35, 50)
        FlyBox.Size = UDim2.new(1, -10, 0, 35)
        FlyBox.Font = Enum.Font.Gotham
        FlyBox.PlaceholderText = "Ketik Fly Speed Bebas (Uncapped)..."
        FlyBox.Text = ""
        FlyBox.TextColor3 = Color3.fromRGB(255, 255, 255)
        FlyBox.TextSize = 12
        
        local FlyCorner = Instance.new("UICorner") FlyCorner.Parent = FlyBox
        
        local FlySpeedVal = 50
        FlyBox.FocusLost:Connect(function()
            local num = tonumber(FlyBox.Text)
            if num then FlySpeedVal = num end
        end)

        local FlyToggle = Instance.new("TextButton")
        FlyToggle.Parent = currentTabContent
        FlyToggle.BackgroundColor3 = Color3.fromRGB(30, 120, 180)
        FlyToggle.Size = UDim2.new(1, -10, 0, 35)
        FlyToggle.Font = Enum.Font.GothamBold
        FlyToggle.Text = "Toggle Fly (CFrame): OFF"
        FlyToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
        FlyToggle.TextSize = 13
        
        local ToggleCorner = Instance.new("UICorner") ToggleCorner.Parent = FlyToggle
        
        local flyActive = false
        local flyConn
        FlyToggle.MouseButton1Click:Connect(function()
            flyActive = not flyActive
            if flyActive then
                FlyToggle.Text = "Toggle Fly (CFrame): ON"
                FlyToggle.BackgroundColor3 = Color3.fromRGB(0, 180, 100)
                flyConn = RunService.RenderStepped:Connect(function()
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local hrp = LocalPlayer.Character.HumanoidRootPart
                        local cam = Workspace.CurrentCamera
                        local move = Vector3.new()
                        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
                        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
                        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
                        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
                        hrp.CFrame = hrp.CFrame + (move * (FlySpeedVal * 0.1))
                        hrp.Velocity = Vector3.new(0,0,0)
                    end
                end)
            else
                FlyToggle.Text = "Toggle Fly (CFrame): OFF"
                FlyToggle.BackgroundColor3 = Color3.fromRGB(30, 120, 180)
                if flyConn then flyConn:Disconnect() end
            end
        end)

        -- 2. WalkSpeed Input
        local WalkBox = Instance.new("TextBox")
        WalkBox.Parent = currentTabContent
        WalkBox.BackgroundColor3 = Color3.fromRGB(25, 35, 50)
        WalkBox.Size = UDim2.new(1, -10, 0, 35)
        WalkBox.Font = Enum.Font.Gotham
        WalkBox.PlaceholderText = "Ketik Walk Speed Bebas..."
        WalkBox.Text = ""
        WalkBox.TextColor3 = Color3.fromRGB(255, 255, 255)
        WalkBox.TextSize = 12
        local WalkCorner = Instance.new("UICorner") WalkCorner.Parent = WalkBox
        
        WalkBox.FocusLost:Connect(function()
            local num = tonumber(WalkBox.Text)
            if num and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = num
            end
        end)
    end
end

