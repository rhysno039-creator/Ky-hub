PlayerTab:Section({ Title = "1. Kontrol Utama" })
PlayerTab:Toggle({
    Title = "Fly", 
    Default = false, 
    Callback = function(V) 
        flyToggled = V
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
