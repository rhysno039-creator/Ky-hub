PlayerTab:Toggle({Title = "Status Speed On/Off", Default = false, Callback = function(V) _G.SpeedEnabled = V end})
PlayerTab:Input({Title = "Speed (Ketik Angka)", Default = "16", Placeholder = "Speed...", Callback = function(T) _G.SpeedVal = tonumber(T) or 16 end})
PlayerTab:Toggle({Title = "Speed Bypass", Default = false, Callback = function(V) _G.SpeedBypass = V end})

RunService.RenderStepped:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        if _G.SpeedEnabled then LocalPlayer.Character.Humanoid.WalkSpeed = _G.SpeedVal end
        if _G.SpeedBypass and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local moveDir = LocalPlayer.Character.Humanoid.MoveDirection
            if moveDir.Magnitude > 0 then hrp.CFrame = hrp.CFrame + (moveDir * (_G.SpeedVal * 0.05)) end
        end
    end
end)

PlayerTab:Toggle({Title = "Status Jump Power On/Off", Default = false, Callback = function(V) _G.JumpEnabled = V end})
PlayerTab:Input({
    Title = "Jump Power (Maksimal 676)", 
    Default = "50", 
    Placeholder = "Jump...", 
    Callback = function(T)
        local num = tonumber(T) or 50
        if num > 676 then num = 676 end
        _G.JumpVal = num
    end
})

RunService.RenderStepped:Connect(function()
    if _G.JumpEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.UseJumpPower = true
        LocalPlayer.Character.Humanoid.JumpPower = _G.JumpVal
    end
end)

PlayerTab:Toggle({Title = "Fly Fitur On/Off", Default = false, Callback = function(V) _G.FlyEnabled = V end})
PlayerTab:Input({Title = "Fly Speed", Default = "50", Placeholder = "Fly Speed...", Callback = function(T) _G.FlySpeed = tonumber(T) or 50 end})

RunService.RenderStepped:Connect(function()
    if _G.FlyEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.Velocity = Vector3.new(0, 0, 0)
        local moveDirection = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + Camera.CFrame.RightVector end
        hrp.CFrame = hrp.CFrame + (moveDirection * (_G.FlySpeed * 0.05))
    end
end)

PlayerTab:Toggle({Title = "Infinite Jump", Default = false, Callback = function(V) _G.InfJump = V end})
UserInputService.JumpRequest:Connect(function()
    if _G.InfJump and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

PlayerTab:Toggle({Title = "Noclip", Default = false, Callback = function(V) _G.Noclip = V end})
RunService.Stepped:Connect(function()
