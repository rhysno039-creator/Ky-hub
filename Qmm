-- =================================================================
-- BACKGROUND RENDER LOOP (Visual & ESP Logic)
-- =================================================================
RunService.RenderStepped:Connect(function()
    pcall(function()
        -- Hitbox Expander Loop
        if hitboxEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    hrp.Size = Vector3.new(hitboxSizeValue, hitboxSizeValue, hitboxSizeValue)
                    hrp.Transparency = 0.5
                    hrp.Color = rainbowColor
                end
            end
        end

        -- Chams ESP Loop
        if chamsEspEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    if not p.Character:FindFirstChild("KyZenChams") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "KyZenChams"
                        hl.Adornee = p.Character
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.Parent = p.Character
                    else
                        local hl = p.Character.KyZenChams
                        hl.FillColor = rainbowColor
                        hl.OutlineColor = rainbowColor
                    end
                end
            end
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("KyZenChams") then
                    p.Character.KyZenChams:Destroy()
                end
            end
        end

        -- Full Brightness Loop
        if fullBrightEnabled then
            Lighting.Brightness = brightLevelValue
            Lighting.GlobalShadows = false
        end

        -- FOV Loop
        if fovEnabled then
            Camera.FieldOfView = fovValue
        end
    end)
end)


