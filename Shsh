-- 6. MOVEMENT TAB
-- ==========================================
MovementTab:Toggle({Title = "Fly Fitur On/Off", Default = false, Callback = function(Value) _G.FlyEnabled = Value end})
MovementTab:Input({Title = "Fly Speed", Default = "50", Placeholder = "Kecepatan...", Callback = function(Text) local val = tonumber(Text) if val then _G.FlySpeed = val end end})

RunService.RenderStepped:Connect(function()
    if _G.FlyEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0, 1, 0) * _G.FlySpeed
    end
end)

MovementTab:Toggle({Title = "High Jump + Bunny Hop", Default = false, Callback = function(Value) _G.BunnyHop = Value end})
RunService.RenderStepped:Connect(function()
    if _G.BunnyHop and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        if LocalPlayer.Character.Humanoid.FloorMaterial ~= Enum.Material.Air then LocalPlayer.Character.Humanoid:Jump() end
    end
end)

