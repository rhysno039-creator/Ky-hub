-- ==================== FUNGSI ESP & LOOP (PLAYER + NPC) ====================
local function getCharacters()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            table.insert(list, p.Character)
        end
    end
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            local isPlayer = Players:GetPlayerFromCharacter(obj)
            if not isPlayer and obj ~= LocalPlayer.Character then
                table.insert(list, obj)
            end
        end
    end
    return list
end

task.spawn(function()
    while true do
        local tickTime = tick()
        local rainbowColor = Color3.fromHSV((tickTime % 5) / 5, 1, 1)
        
        -- Rainbow Chams
        if rainbowChamsEnabled then
            for _, char in pairs(getCharacters()) do
                if not char:FindFirstChild("KyZenHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "KyZenHighlight"
                    hl.Adornee = char
                    hl.Parent = char
                else
                    char.KyZenHighlight.FillColor = rainbowColor
                end
            end
        else
            for _, char in pairs(getCharacters()) do
                if char:FindFirstChild("KyZenHighlight") then
                    char.KyZenHighlight:Destroy()
                end
            end
        end

        -- Rainbow Hitbox ESP (Padat & Berwarna)
        if rainbowHitboxEnabled then
            for _, char in pairs(getCharacters()) do
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Size = Vector3.new(hitboxSizeValue, hitboxSizeValue, hitboxSizeValue)
                    hrp.Transparency = 0.5
                    hrp.Color = rainbowColor
                    hrp.Material = Enum.Material.Neon
                    hrp.CanCollide = false
                end
            end
        end

        -- Name, Distance & Health ESP
        if playerEspEnabled or healthEspEnabled then
            for _, char in pairs(getCharacters()) do
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                if hrp and hum then
                    local tag = char:FindFirstChild("KyZenESP_Tag")
                    if not tag then
                        tag = Instance.new("BillboardGui")
                        tag.Name = "KyZenESP_Tag"
                        tag.Size = UDim2.new(0, 200, 0, 50)
                        tag.StudsOffset = Vector3.new(0, 3, 0)
                        tag.AlwaysOnTop = true
                        tag.Parent = char
                        
                        local textLabel = Instance.new("TextLabel")
                        textLabel.Name = "Text"
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.TextColor3 = Color3.new(1, 1, 1)
                        textLabel.TextStrokeTransparency = 0
                        textLabel.TextSize = 13
                        textLabel.Font = Enum.Font.SourceSansBold
                        textLabel.Parent = tag
                    end
                    
                    local textLabel = tag:FindFirstChild("Text")
                    if textLabel then
                        local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
                        local nameText = playerEspEnabled and (char.Name .. " [" .. dist .."m]") or ""
                        local healthText = healthEspEnabled and ("\nHealth: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)) or ""
                        textLabel.Text = nameText .. healthText
                    end
                end
            end
        else
            for _, char in pairs(getCharacters()) do
                if char:FindFirstChild("KyZenESP_Tag") then
                    char.KyZenESP_Tag:Destroy()
                end
            end
        end

        task.wait(0.5)
    end
end)

-- Main RenderStepped Loop
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    
    if flyToggled and char:FindFirstChild("HumanoidRootPart") and bodyVelocity and bodyGyro then
        bodyGyro.CFrame = Camera.CFrame
        local moveDirection = hum.MoveDirection
        local ySpeed = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then ySpeed = flySpeed end
        bodyVelocity.Velocity = (Camera.CFrame.LookVector * (moveDirection.Magnitude > 0 and flySpeed or 0)) + Vector3.new(0, ySpeed, 0)
    end

    if walkSpeedEnabled and hum then
        hum.WalkSpeed = customWalkSpeed
    end

    if fullBrightEnabled then
        Lighting.Brightness = brightLevelValue
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
    end

    if fovEnabled then
        Camera.FieldOfView = fovValue
    end
end)

