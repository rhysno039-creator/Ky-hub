-- Fungsi Logika Pencarian Fitur
local function searchFeature(query)
    local q = string.lower(query)
    if q == "" then return end
    
    local found = false
    for _, feat in ipairs(featureDatabase) do
        if feat.keyword:find(q) or string.lower(feat.name):find(q) then
            found = true
            -- Berpindah ke tab tempat fitur tersebut berada
            Window:SelectTab(feat.tabIndex)
            -- Membuka laci fitur terkait secara otomatis
            pcall(function()
                if feat.drawer and feat.drawer.SetOpened then
                    feat.drawer:SetOpened(true)
                end
            end)
            
            WindUI:Notify({
                Title = "Fitur Ditemukan: " .. feat.name,
                Content = feat.desc .. "\n(Laci fitur telah dibuka otomatis)",
                Duration = 4
            })
            break
        end
    end
    
    if not found then
        WindUI:Notify({
            Title = "Pencarian Gagal",
            Content = "Fitur dengan kata kunci '" .. query .. "' tidak ditemukan.",
            Duration = 3
        })
    end
end

-- Menambahkan Input Search ke Setiap Tab/Menu
local function addSearchInput(tab, tabName)
    tab:Input({
        Title = "Cari Fitur di " .. tabName,
        Icon = "search",
        Placeholder = "Ketik nama fitur (mis: fly, esp, speed)...",
        Value = "",
        Callback = function(v)
            searchFeature(v)
        end
    })
end

