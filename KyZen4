-- Fungsi Pembuat Toggle Button Kompak
local function createCustomToggle(name, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 32)
    btn.Position = UDim2.new(0, 8, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.Text = name .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 90, 90)
    btn.TextSize = 12
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = contentScroll

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.Text = name .. ": ON"
            btn.TextColor3 = Color3.fromRGB(90, 255, 90)
            btn.BackgroundColor3 = Color3.fromRGB(30, 70, 30)
        else
            btn.Text = name .. ": OFF"
            btn.TextColor3 = Color3.fromRGB(255, 90, 90)
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        end
        callback(active)
    end)

    return {
        SetState = function(state)
            active = state
            if active then
                btn.Text = name .. ": ON"
                btn.TextColor3 = Color3.fromRGB(90, 255, 90)
                btn.BackgroundColor3 = Color3.fromRGB(30, 70, 30)
            else
                btn.Text = name .. ": OFF"
                btn.TextColor3 = Color3.fromRGB(255, 90, 90)
                btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            end
        end
    }
end

local function createToggle(name, yPos, callback)
    createCustomToggle(name, yPos, callback)
end

