PlayerTab:Toggle({
    Title = "Speed Bypass (Anti Anti-Cheat WalkSpeed)",
    Default = false,
    Callback = function(Value) _G.SpeedBypass = Value end
})

RunService.RenderStepped:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        if _G.SpeedEnabled then
            LocalPlayer.Character.Humanoid.WalkSpeed = _G.SpeedVal
        end
        if _G.SpeedBypass and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local moveDir = LocalPlayer.Character.Humanoid.MoveDirection
            if moveDir.Magnitude > 0 then
                hrp.CFrame = hrp.CFrame + (moveDir * (_G.SpeedVal * 0.05))
            end
        end
    end
end)

PlayerTab:Toggle({
    Title = "Status Jump Power On/Off",
    Default = false,
    Callback = function(Value) _G.JumpEnabled = Value end
})

PlayerTab:Input({
    Title = "Jump Power (Maksimal 676)",
    Default = "50",
    Placeholder = "Angka jump...",
    Callback = function(Text)
        local num = tonumber(Text)
        if num then
            if num > 676 then num = 676 end
            _G.JumpVal = num
        end
    end
})

RunService.RenderStepped:Connect(function()
    if _G.JumpEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.UseJumpPower = true
        LocalPlayer.Character.Humanoid.JumpPower = _G.JumpVal
    end
end)

PlayerTab:Toggle({
