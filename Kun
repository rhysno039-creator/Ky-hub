RunService.Stepped:Connect(function()
    if Flags.NoSlow then
        local hum = getHumanoid()
        if hum then hum.WalkSpeed = Flags.Speed and Flags.SpeedValue or 16 end
    end
end)

MoveTab:CreateToggle({
    Name = "Status Immunity",
    CurrentValue = false,
    Callback = function(Value) Flags.NoSlow = Value end
})

