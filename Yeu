-- ==================== TAB 6: TROLL & TP ====================
local TrollTab = Window:Tab({ Title = "Troll & TP", Icon = "crosshair" })
local selectedTarget = nil
local tpSpeed = 16

TrollTab:Section({ Title = "1. Target Pemilik" })
local playerList = {}
for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then table.insert(playerList, p.Name) end
end

local dropdownRef
dropdownRef = TrollTab:Dropdown({
    Title = "List Player",
    Values = playerList,
    Callback = function(val) selectedTarget = val end
})

TrollTab:Button({
    Title = "Refresh Player List",
    Callback = function()
        local newList = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(newList, p.Name) end
        end
        dropdownRef:SetValues(newList)
        WindUI:Notify({ Title = "Refresh", Content = "Daftar player diperbarui.", Duration = 2 })
    end
})

TrollTab:Section({ Title = "2. Aksi Teleportasi & Troll" })
TrollTab:Button({
    Title = "Teleport ke Player Terpilih",
    Callback = function()
        if selectedTarget then
            local targetPlayer = Players:FindFirstChild(selectedTarget)
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myHrp then
                    myHrp.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                    WindUI:Notify({ Title = "Teleport", Content = "Berpindah ke " .. selectedTarget, Duration = 2 })
                end
            end
        end
    end
})

TrollTab:Input({
    Title = "Atur Speed Teleport / Run", Default = "16", Placeholder = "Kecepatan...",
    Callback = function(val) local num = tonumber(val) if num then tpSpeed = num end end
})

TrollTab:Button({
    Title = "Save and Run (Walkto Target)",
    Callback = function()
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum and selectedTarget then
            local targetPlayer = Players:FindFirstChild(selectedTarget)
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                hum.WalkSpeed = tpSpeed
                hum:MoveTo(targetPlayer.Character.HumanoidRootPart.Position)
            end
        end
    end
})

-- ==================== UI TERPISAH FLUENT (TELEPORT & RUN) ====================
TrollTab:Section({ Title = "3. Menu Teleport & Run Terpisah" })

local fluentWindowOpened = false

local function OpenFluentTeleportUI()
    if fluentWindowOpened then return end
    fluentWindowOpened = true

    local FluentWindow = Fluent:CreateWindow({
        Title = "Teleport & Run Hub",
        SubTitle = "by kyzen868",
        TabWidth = 120,
        Size = UDim2.fromOffset(480, 380),
        Acrylic = false,
        Theme = "Dark",
        MinimizeKey = Enum.KeyCode.LeftControl
    })

    local FluentTab = FluentWindow:AddTab({ Title = "5 Locations", Icon = "map-pin" })
    local savedLocations = {}
    local fluentRunSpeed = 16

    FluentTab:AddInput("FluentRunSpeedInput", {
        Title = "Run Speed (1 - 100)",
        Default = "16",
        Placeholder = "Masukkan angka...",
        Numeric = true,
        Finished = true,
        Callback = function(Value)
            local num = tonumber(Value)
            if num then fluentRunSpeed = math.clamp(num, 1, 100) end
        end
    })

    for i = 1, 5 do
        FluentTab:AddParagraph({
            Title = "Slot Lokasi " .. i,
            Content = "Simpan posisi atau lakukan aksi teleport/run."
        })

        FluentTab:AddButton({
            Title = "Slot " .. i .. " - Save Posisi",
            Callback = function()
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    savedLocations[i] = hrp.CFrame
                    Fluent:Notify({ Title = "Berhasil", Content = "Posisi slot " .. i .. " disimpan!", Duration = 2 })
                end
            end
        })

        FluentTab:AddButton({
            Title = "Slot " .. i .. " - Teleport Instan",
            Callback = function()
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp and savedLocations[i] then
                    hrp.CFrame = savedLocations[i]
                else
                    Fluent:Notify({ Title = "Gagal", Content = "Lokasi slot " .. i .. " belum ada!", Duration = 2 })
                end
            end
        })

        FluentTab:AddButton({
            Title = "Slot " .. i .. " - Run (Jalan ke Lokasi)",
            Callback = function()
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChild("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hum and hrp and savedLocations[i] then
                    hum.WalkSpeed = fluentRunSpeed
                    hum:MoveTo(savedLocations[i].Position)
                else
                    Fluent:Notify({ Title = "Gagal", Content = "Lokasi slot " .. i .. " belum ada!", Duration = 2 })
                end
            end
        })
    end

    -- Deteksi saat window Fluent ditutup untuk mereset status
    FluentWindow.CloseEvent:Connect(function()
        fluentWindowOpened = false
    end)

    WindUI:Notify({ Title = "Fluent UI", Content = "Menu Teleport & Run berhasil dibuka!", Duration = 2 })
end

TrollTab:Button({
    Title = "Buka Menu Teleport & Run (Fluent)",
    Callback = function()
        OpenFluentTeleportUI()
    end
})


-- ==================== LOOP RUNTIME ====================
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if flyToggled and hrp and bodyVelocity and bodyGyro then
            bodyGyro.CFrame = Camera.CFrame
            local moveDirection = hum.MoveDirection
            local ySpeed = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then ySpeed = flySpeed end
            bodyVelocity.Velocity = (Camera.CFrame.LookVector * (moveDirection.Magnitude > 0 and flySpeed or 0)) + Vector3.new(0, ySpeed, 0)
        end
        if fullBrightEnabled then Lighting.Brightness = 2 Lighting.GlobalShadows = false end
    end)
end)

WindUI:Notify({ Title = "KyZen HUB", Content = "Berhasil Diexecute! ✅", Duration = 3 })
