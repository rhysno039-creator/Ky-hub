-- Status Label
local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 25)
StatusLabel.Position = UDim2.new(0, 0, 0, 185)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = "Status: Waiting for key input..."
StatusLabel.TextColor3 = Color3.fromRGB(160, 160, 180)
StatusLabel.TextSize = 13
StatusLabel.Font = Enum.Font.Gotham
StatusLabel.Parent = MainFrame

local keyAuthenticated = false

-- Tombol Get Key: Otomatis copy ke clipboard SEKALIGUS isi textbox secara otomatis
GetKeyBtn.MouseButton1Click:Connect(function()
    pcall(function() setclipboard(sessionKey) end)
    TextBox.Text = sessionKey
    StatusLabel.Text = "Status: Key copied & auto-filled!"
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
end)

-- Auto verify begitu text terisi atau berubah cocok dengan key
TextBox:GetPropertyChangedSignal("Text"):Connect(function()
    if keyAuthenticated then return end
    local input = TextBox.Text
    local isValid = false
    
    for _, k in pairs(keysList) do
        if input == k or input == sessionKey then
            isValid = true
            break
        end
    end
    
    if isValid then
        keyAuthenticated = true
        StatusLabel.Text = "Status: Success! Opening Hub..."
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        task.wait(0.5)
        ScreenGui:Destroy()
    end
end)

while not keyAuthenticated do
    task.wait(0.1)
end

