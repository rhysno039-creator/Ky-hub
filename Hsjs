-- ==================== LOOP RENDER STEPPED UTAMA ====================
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    
    -- Loop Fly
    if flyToggled and hrp and bodyVelocity and bodyGyro then
        bodyGyro.CFrame = Camera.CFrame
        local moveDirection = hum.MoveDirection
        local ySpeed = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            ySpeed = flySpeed
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
            ySpeed = -flySpeed
        end
        bodyVelocity.Velocity = (Camera.CFrame.LookVector * (moveDirection.Magnitude > 0 and flySpeed or 0)) + Vector3.new(0, ySpeed, 0)
    end

    -- Loop Walk Speed
    if walkSpeedEnabled and hum then
        hum.WalkSpeed = customWalkSpeed
    end

    -- Loop Moon Walk
    if moonWalkEnabled and hum and hrp then
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(180), 0)
            hum.WalkSpeed = moonWalkSpeed
        else
            hum.WalkSpeed = moonWalkSpeed
        end
    end

    -- Loop Bunny Hop
    if _G.BunnyHop and hum then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end

    -- Loop Shift Lock
    if _G.ShiftLockEnabled and hrp then
        local camCFrame = Camera.CFrame
        hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(camCFrame.LookVector.X * 9e9, hrp.Position.Y, camCFrame.LookVector.Z * 9e9))
    end

    -- Loop Full Bright
    if fullBrightEnabled then
        Lighting.Brightness = brightLevel
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
    end

    -- Loop FOV
    if fovEnabled then
        Camera.FieldOfView = fovValue
    end

    -- Rainbow Color Generator untuk ESP
    local tickTime = tick() * 5
    local rainbowColor = Color3.fromHSV(tickTime % 1, 1, 1)

    -- Sederhana: Sistem Chams & Highlights otomatis untuk Player dan NPC
    if rainbowChamsEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local chModel = p.Character
                if not chModel:FindFirstChild("KyZenHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "KyZenHighlight"
                    hl.Adornee = chModel
                    hl.Parent = chModel
                else
                    chModel.KyZenHighlight.FillColor = rainbowColor
                    chModel.KyZenHighlight.OutlineColor = Color3.new(1,1,1)
                end
            end
        end
    end
end)
