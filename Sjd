-- RUNTIME LOOP (Aman dari Crash Executor)
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")

        if flyToggled and hrp and bodyVelocity and bodyGyro then
            bodyGyro.CFrame = Camera.CFrame
            local moveDirection = hum.MoveDirection
            local ySpeed = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then ySpeed = flySpeed end
            bodyVelocity.Velocity = (Camera.CFrame.LookVector * (moveDirection.Magnitude > 0 and flySpeed or 0)) + Vector3.new(0, ySpeed, 0)
        end

        if runTabEnabled and hum then hum.WalkSpeed = customRunSpeed end
        if jumpPowerEnabled and hum then hum.JumpPower = customJumpPower end
        if noclipEnabled then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
        if fullBrightEnabled then Lighting.Brightness = brightLevelValue Lighting.GlobalShadows = false end

        if espEnabled then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and hrp then
                    local head = p.Character.Head
                    local billboard = head:FindFirstChild("KyZenBoxEspTag")
                    if not billboard then
                        billboard = Instance.new("BillboardGui")
                        billboard.Name = "KyZenBoxEspTag"
                        billboard.Size = UDim2.new(0, 100, 0, 40)
                        billboard.StudsOffset = Vector3.new(0, 3, 0)
                        billboard.AlwaysOnTop = true
                        
                        local textLabel = Instance.new("TextLabel")
                        textLabel.Name = "EspText"
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.Font = Enum.Font.GothamBold
                        textLabel.TextSize = 11
                        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                        textLabel.TextStrokeTransparency = 0.5
                        textLabel.Parent = billboard
                        
                        billboard.Parent = head
                        table.insert(espGuiList, billboard)
                    end
                    local textLabel = billboard:FindFirstChild("EspText")
                    if textLabel and p.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = math.floor((hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude)
                        textLabel.Text = p.Name .. " [" .. dist .. "m]"
                    end
                end
            end
        else
            clearEspGuis()
        end
    end)
end)

