-- 4. VISUAL TAB
-- ==========================================
VisualTab:Toggle({
    Title = "Player Chams / Highlight",
    Default = false,
    Callback = function(Value)
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                if Value then
                    local hl = Instance.new("Highlight", p.Character)
                    hl.Name = "KyZenChams"
                else
                    if p.Character:FindFirstChild("KyZenChams") then p.Character.KyZenChams:Destroy() end
                end
            end
        end
    end
})

VisualTab:Toggle({
    Title = "Fullbright",
    Default = false,
    Callback = function(Value)
        Lighting.Brightness = Value and 2 or 1
        Lighting.GlobalShadows = not Value
    end
})

VisualTab:Input({
    Title = "FOV (Ketikan 70 - 120)",
    Default = "70",
    Placeholder = "70 sampai 120",
    Callback = function(Text)
        local val = tonumber(Text)
        if val and val >= 70 and val <= 120 then Camera.FieldOfView = val end
    end
})

-- ==========================================
-- 5. COMBAT TAB
-- ==========================================
CombatTab:Toggle({
    Title = "Aimbot Universal",
    Default = false,
    Callback = function(Value)
        _G.Aimbot = Value
    end
})

RunService.RenderStepped:Connect(function()
    if _G.Aimbot then
        pcall(function()
            local target, dist = nil, math.huge
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                    local mag = (p.Character.Head.Position - Camera.CFrame.Position).Magnitude
                    if mag < dist then dist = mag target = p.Character.Head end
                end
            end
            if target then Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position) end
        end)
    end
end)

CombatTab:Toggle({Title = "Hitbox Expander On/Off", Default = false, Callback = function(Value) _G.HitboxEnabled = Value end})
CombatTab:Input({Title = "Hitbox Size (2 - 50)", Default = "2", Placeholder = "Ukuran...", Callback = function(Text) local val = tonumber(Text) if val then _G.HitboxSize = val end end})

RunService.RenderStepped:Connect(function()
    if _G.HitboxEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                p.Character.HumanoidRootPart.Size = Vector3.new(_G.HitboxSize, _G.HitboxSize, _G.HitboxSize)
                p.Character.HumanoidRootPart.Transparency = 0.7
                p.Character.HumanoidRootPart.CanCollide = false
            end
        end
    end
end)

