-- ==========================================
-- BACKGROUND RUNTIME LOOPS (RenderStepped & Heartbeat)
-- ==========================================
RunService.RenderStepped:Connect(function()
    local hum = getHumanoid()
    local root = getRoot()
    local char = getCharacter()

    -- 1. Fly NoClip Logic
    if Flags.Fly and Flags.FlyNoClip and char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    -- 2. Fly Movement Logic (Analog HP Normal & Smooth)
    if Flags.Fly and hum and root then
        hum.PlatformStand = true
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            root.Velocity = Vector3.new(moveDir.X * Flags.FlySpeed, root.Velocity.Y, moveDir.Z * Flags.FlySpeed)
        else
            root.Velocity = Vector3.new(0, 0, 0)
        end
    end

    -- 3. Shift Lock Logic
    if Flags.ShiftLock and not Flags.Fly and root then
        local lookVector = Camera.CFrame.LookVector
        root.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(lookVector.X, 0, lookVector.Z))
    end

    -- 4. Phase Walk Logic
    if Flags.PhaseWalk and hum and root and hum.MoveDirection.Magnitude > 0 then
        root.CFrame = root.CFrame + (hum.MoveDirection * (Flags.PhaseSpeed / 50))
    end

    -- 5. Hyper Bunny Hop Logic
    if Flags.BunnyHop and hum then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end

    -- 6. Hitbox Expander Logic
    if Flags.HitboxExpander then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                p.Character.HumanoidRootPart.Size = Vector3.new(Flags.HitboxSize, Flags.HitboxSize, Flags.HitboxSize)
                p.Character.HumanoidRootPart.Transparency = 0.7
                p.Character.HumanoidRootPart.CanCollide = false
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local hum = getHumanoid()
    if Flags.WalkSpeed and hum then hum.WalkSpeed = Flags.WalkSpeedValue end
    if Flags.NoSlow and hum then hum.WalkSpeed = Flags.WalkSpeed and Flags.WalkSpeedValue or DefaultWalkSpeed end
end)

RunService.Stepped:Connect(function()
    local char = getCharacter()
    if Flags.NoClip and char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    if Flags.WallClimb then
        local rootPart = getRoot()
        if rootPart then
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = {char}
            params.FilterType = Enum.RaycastFilterType.Exclude
            local result = Workspace:Raycast(rootPart.Position, rootPart.CFrame.LookVector * 3, params)
            if result and result.Instance then
                rootPart.Velocity = Vector3.new(rootPart.Velocity.X, 60, rootPart.Velocity.Z)
            end
        end
    end
end)

