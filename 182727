local rainbowTracersEnabled = false
local rainbowSkeletonEnabled = false
local tracersList = {}
local healthGuiList = {}
local espGuiList = {}
local skeletonGuiList = {}

local function removeTracers()
    for _, line in pairs(tracersList) do
        pcall(function() line:Remove() end)
    end
    tracersList = {}
end

local function clearHealthGuis()
    for _, gui in pairs(healthGuiList) do
        pcall(function() gui:Destroy() end)
    end
    healthGuiList = {}
end

local function clearEspGuis()
    for _, gui in pairs(espGuiList) do
        pcall(function() gui:Destroy() end)
    end
    espGuiList = {}
end

local function clearSkeletonGuis()
    for _, gui in pairs(skeletonGuiList) do
        pcall(function() gui:Destroy() end)
    end
    skeletonGuiList = {}
end

