HomeTab:Button({
    Title = "Server Hop",
    Desc = "Pindah ke server publik lain secara acak",
    Callback = function()
        task.spawn(function()
            local successReq, req = pcall(function()
                return game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")
            end)
            
            if successReq and req then
                local successDec, body = pcall(function()
                    return HttpService:JSONDecode(req)
                end)
                
                if successDec and body and body.data then
                    local servers = {}
                    for _, s in ipairs(body.data) do
                        if s.id ~= game.JobId and s.playing < s.maxPlayers then
                            table.insert(servers, s.id)
                        end
                    end
                    
                    if #servers > 0 then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
                        return
                    end
                end
            end
            WindUI:Notify({ Title = "Gagal", Content = "Tidak ada server lain yang ditemukan!", Duration = 3 })
        end)
    end
})

HomeTab:Button({
    Title = "Hop Low Player",
    Desc = "Pindah ke server dengan jumlah pemain paling sedikit",
    Callback = function()
        task.spawn(function()
            local targetServer = nil
            local minPlayers = math.huge
            local successReq, req = pcall(function()
                return game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")
            end)
            
            if successReq and req then
                local successDec, body = pcall(function()
                    return HttpService:JSONDecode(req)
                end)
                
                if successDec and body and body.data then
                    for _, s in ipairs(body.data) do
                        if s.id ~= game.JobId and s.playing < minPlayers then
                            minPlayers = s.playing
                            targetServer = s.id
                        end
                    end
                end
            end
            
            if targetServer then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer, LocalPlayer)
            else
                WindUI:Notify({ Title = "Gagal", Content = "Tidak dapat menemukan server sepi!", Duration = 3 })
            end
        end)
    end
})

