-- 2. Rainbow Air Platform
local rainbowPlatform = false
local plat = nil
PlayerTab:Toggle({
    Title = "Rainbow Air Platform [ON/OFF]",
    Callback = function(v)
        rainbowPlatform = v
        if v then
            plat = Instance.new("Part")
            plat.Size = Vector3.new(5, 1, 5)
            plat.Anchored = true
            plat.Parent = workspace
            task.spawn(function()
                while rainbowPlatform do
                    for hue = 0, 1, 0.01 do
                        if not rainbowPlatform then break end
                        plat.Color = Color3.fromHSV(hue, 1, 1)
                        local char = plr.Character
                        if char and char:FindFirstChild("HumanoidRootPart") then
