TrollFETab:CreateSection("Fitur Troll Server-Sided")
TrollFETab:CreateToggle({
   name = "Invisible FE",
   currentValue = false,
   callback = function(Value)
      Rayfield:Notify({ title = "Troll FE", content = "Status Invisible: " .. tostring(Value), duration = 3 })
   end,
})

TrollFETab:CreateButton({
   name = "Fling All",
   callback = function()
      Rayfield:Notify({ title = "Troll FE", content = "Fling dieksekusi!", duration = 3 })
   end,
})

