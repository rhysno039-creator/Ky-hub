-- 3. Bunny Hop
PlayerTab:Toggle({Title = "Bunny Hop", Default = false, Callback = function(V) _G.BunnyHop = V end})

-- 4. Kontrol Utama (Fly & Kecepatan)
PlayerTab:Paragraph({ Title = "🚀 Kontrol Utama (Fly & Kecepatan)", Desc = "Pengaturan fitur terbang utama dan kecepatan karakter." })

PlayerTab:Toggle({
    Title = "Fly", 
    Default = false, 
    Callback = function(V) 
        flyToggled = V
        _G.FlyEnabled = V
        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        
        if flyToggled and hrp and hum then
            hum.PlatformStand = true
            bodyVelocity = Instance.new("BodyVelocity", hrp)
            bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyGyro = Instance.new("BodyGyro", hrp)
            bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyGyro.P = 20000
            bodyGyro.CFrame = Camera.CFrame
        else
            if hum then hum.PlatformStand = false end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
        end
    end
})

PlayerTab:Input({
    Title = "Ketik Fly Speed di sini", 
    Default = "50", 
    Placeholder = "Masukkan angka...", 
    Callback = function(val) 
        flySpeed = tonumber(val) or 50 
        _G.FlySpeed = flySpeed
    end
})

PlayerTab:Toggle({
    Title = "Walk Speed", 
    Default = false, 
    Callback = function(V) 
        _G.SpeedEnabled = V 
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then
            hum.WalkSpeed = V and customWalkSpeed or 16
        end
    end
})

PlayerTab:Input({
    Title = "Ketik Angka WalkSpeed",
    Placeholder = "Contoh: 35",
    Callback = function(value)
        local num = tonumber(value)
        if num then
            customWalkSpeed = num
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
            if _G.SpeedEnabled and hum then
                hum.WalkSpeed = customWalkSpeed
            end
            WindUI:Notify({ Title = "Speed", Content = "Kecepatan diatur ke: " .. num, Duration = 2 })
        end
    end
})

-- Logika Eksekusi RenderStepped untuk MoonWalk, Fly, BunnyHop, ShiftLock, & WalkSpeed
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    
    -- Loop Fly
    if flyToggled and hrp and bodyVelocity and bodyGyro then
        bodyGyro.CFrame = Camera.CFrame
        local moveDirection = hum.MoveDirection
        bodyVelocity.Velocity = moveDirection * flySpeed
    end

    -- Loop Walk Speed
    if _G.SpeedEnabled and hum then
        hum.WalkSpeed = customWalkSpeed
    end

    -- Loop Moon Walk (Membalikkan arah gerak / rotasi saat berjalan)
    if _G.MoonWalkEnabled and hum and hrp then
        if hum.MoveDirection.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(180), 0)
        end
    end

    -- Loop Bunny Hop
    if _G.BunnyHop and hum and hum.FloorMaterial ~= Enum.Material.Air then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end

    -- Loop Shift Lock
    if _G.ShiftLockEnabled and hrp then
        local camCFrame = Camera.CFrame
        hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(camCFrame.LookVector.X * 9e9, hrp.Position.Y, camCFrame.LookVector.Z * 9e9))
    end
end)

