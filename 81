RunService.RenderStepped:Connect(function()
    pcall(function()
        local tickTime = tick() * 5
        local rainbowColor = Color3.fromHSV(tickTime % 1, 1, 1)

        -- Logika Custom Display Name & Verified Badge
        local localChar = LocalPlayer.Character
        local localHead = localChar and localChar:FindFirstChild("Head")
        if customNameEnabled and localHead then
            if not customNameGui then
                customNameGui = Instance.new("BillboardGui")
                customNameGui.Name = "KyZenCustomNameTag"
                customNameGui.Size = UDim2.new(0, 200, 0, 50)
                customNameGui.StudsOffset = Vector3.new(0, 2.8, 0)
                customNameGui.AlwaysOnTop = true

                local textLab = Instance.new("TextLabel")
                textLab.Name = "NameText"
                textLab.Size = UDim2.new(1, 0, 1, 0)
                textLab.BackgroundTransparency = 1
                textLab.Font = Enum.Font.GothamBold
                textLab.TextSize = 14
                textLab.TextColor3 = Color3.fromRGB(255, 255, 255)
                textLab.TextStrokeTransparency = 0.3
                textLab.Parent = customNameGui

                customNameGui.Parent = localHead
            end

            local textLab = customNameGui:FindFirstChild("NameText")
            if textLab then
                local badgeStr = verifiedBadgeEnabled and " ✅" or ""
                textLab.Text = customDisplayNameText .. badgeStr
            end
        else
            if customNameGui then
                customNameGui:Destroy()
                customNameGui = nil
            end
        end

        -- Logika Air Platform
        local charCheck = LocalPlayer.Character
        local hrpCheck = charCheck and charCheck:FindFirstChild("HumanoidRootPart")
        if airPlatformEnabled and hrpCheck then
            if not airPlatformPart then
                airPlatformPart = Instance.new("Part")
                airPlatformPart.Size = Vector3.new(5, 1, 5)
                airPlatformPart.Anchored = true
                airPlatformPart.Transparency = 0.5
                airPlatformPart.Material = Enum.Material.Neon
                airPlatformPart.Parent = workspace
            end
            airPlatformPart.Color = rainbowColor
            airPlatformPart.CFrame = hrpCheck.CFrame - Vector3.new(0, 3.5, 0)
        else
            if airPlatformPart then
                airPlatformPart:Destroy()
                airPlatformPart = nil
            end
        end

        -- Logika Freecam + Noclip Berjalan Kamera
        if freecamEnabled and freecamPart then
            local camCF = Camera.CFrame
            local moveVector = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVector = moveVector + camCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVector = moveVector - camCF.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVector = moveVector - camCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVector = moveVector + camCF.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveVector = moveVector + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveVector = moveVector - Vector3.new(0, 1, 0) end
            
            freecamPart.CFrame = freecamPart.CFrame + (moveVector * (freecamSpeed * 0.05))
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + camCF.LookVector)
        end

        if fovDrawing then
            fovDrawing.Visible = fovCircleEnabled
            if fovCircleEnabled then
                fovDrawing.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                fovDrawing.Radius = fovRadius
                fovDrawing.Color = rainbowColor
            end
        end

        if aimbotEnabled then
            local closestTarget = nil
            local shortestDistance = fovRadius

            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local isTeamValid = true
                    if teamCheckEnabled and p.Team == LocalPlayer.Team then
                        isTeamValid = false
                    end

                    if isTeamValid then
                        local targetPart = (hitboxHeadEnabled and p.Character:FindFirstChild("Head")) or p.Character:FindFirstChild("HumanoidRootPart")
                        local hum = p.Character:FindFirstChild("Humanoid")
                        
                        if targetPart and hum and hum.Health > 0 then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                            if onScreen then
                                local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                                local distanceToMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude

                                if distanceToMouse < shortestDistance then
                                    shortestDistance = distanceToMouse
                                    closestTarget = targetPart
                                end
                            end
                        end
                    end
                end
            end

            if closestTarget then
                local currentCFrame = Camera.CFrame
                local targetCFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
                Camera.CFrame = currentCFrame:Lerp(targetCFrame, 1 / math.max(smoothnessVal, 1))
            end
        end

        if rainbowTracersEnabled and Drawing then
            removeTracers()
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local targetHrp = p.Character.HumanoidRootPart
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetHrp.Position)
                    if onScreen then
                        local line = Drawing.new("Line")
                        line.Visible = true
                        line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(screenPos.X, screenPos.Y)
                        line.Color = rainbowColor
                        line.Thickness = 1.5
                        line.Transparency = 0.8
                        table.insert(tracersList, line)
                    end
                end
            end
        end

        if hitboxEnabled then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    hrp.Size = Vector3.new(hitboxSizeValue, hitboxSizeValue, hitboxSizeValue)
                    hrp.Transparency = 0.5
                    hrp.CanCollide = false
                    
                    local highlight = hrp:FindFirstChild("KyZenHitboxHighlight")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "KyZenHitboxHighlight"
                        highlight.Parent = hrp
                    end
                    highlight.FillColor = rainbowColor
                    highlight.OutlineColor = rainbowColor
                    highlight.FillTransparency = 0.4
                end
            end
        end

        if flingAllEnabled then
            local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHrp then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        p.Character.HumanoidRootPart.Velocity = Vector3.new(99999, 99999, 99999)
                    end
                end
            end
        end

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local char = p.Character
                local highlight = char:FindFirstChild("KyZenRainbowHighlight")
                
                if (espEnabled or chamsEspEnabled) then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "KyZenRainbowHighlight"
                        highlight.Parent = char
                    end
                    highlight.Enabled = true
                    highlight.FillColor = rainbowColor
                    highlight.OutlineColor = rainbowColor
                    highlight.FillTransparency = chamsEspEnabled and 0.5 or 1
                    highlight.OutlineTransparency = 0
                else
                    if highlight and not rainbowSkeletonEnabled then highlight:Destroy() end
                end

                if rainbowSkeletonEnabled then
                    local skelHighlight = char:FindFirstChild("KyZenSkeletonHighlight")
                    if not skelHighlight then
                        skelHighlight = Instance.new("Highlight")
                        skelHighlight.Name = "KyZenSkeletonHighlight"
                        skelHighlight.Parent = char
                        table.insert(skeletonGuiList, skelHighlight)
                    end
                    skelHighlight.Enabled = true
                    skelHighlight.FillColor = rainbowColor
                    skelHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    skelHighlight.FillTransparency = 0.8
                    skelHighlight.OutlineTransparency = 0.2
                end

                if espEnabled and char:FindFirstChild("Head") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local head = char.Head
                    local billboard = head:FindFirstChild("KyZenBoxEspTag")
                    
                    if not billboard then
                        billboard = Instance.new("BillboardGui")
                        billboard.Name = "KyZenBoxEspTag"
                        billboard.Size = UDim2.new(0, 120, 0, 50)
                        billboard.StudsOffset = Vector3.new(0, 3.8, 0)
                        billboard.AlwaysOnTop = true
                        
                        local textLabel = Instance.new("TextLabel")
                        textLabel.Name = "EspText"
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.Font = Enum.Font.GothamBold
                        textLabel.TextSize = 12
                        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                        textLabel.TextStrokeTransparency = 0.4
                        textLabel.Parent = billboard
                        
                        billboard.Parent = head
                        table.insert(espGuiList, billboard)
                    end
                    
                    local textLabel = billboard:FindFirstChild("EspText")
                    if textLabel and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("HumanoidRootPart") then
                        local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - char.HumanoidRootPart.Position).Magnitude)
                        textLabel.Text = "👤 " .. p.Name .. "\n[ " .. dist .. " studs ]"
                    end
                end
            end
        end

        if not espEnabled then clearEspGuis() end
        if not rainbowSkeletonEnabled then clearSkeletonGuis() end

        if healthEspEnabled then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") then
                    local head = p.Character.Head
                    local hum = p.Character.Humanoid
                    local billboard = head:FindFirstChild("KyZenHealthTag")
                    
                    if not billboard then
                        billboard = Instance.new("BillboardGui")
                        billboard.Name = "KyZenHealthTag"
                        billboard.Size = UDim2.new(0, 100, 0, 40)
                        billboard.StudsOffset = Vector3.new(0, 2.2, 0)
                        billboard.AlwaysOnTop = true
                        
                        local textLabel = Instance.new("TextLabel")
                        textLabel.Name = "HealthText"
                        textLabel.Size = UDim2.new(1, 0, 1, 0)
                        textLabel.BackgroundTransparency = 1
                        textLabel.Font = Enum.Font.GothamBold
                        textLabel.TextSize = 13
                        textLabel.TextStrokeTransparency = 0.5
                        textLabel.Parent = billboard
                        
                        billboard.Parent = head
                        table.insert(healthGuiList, billboard)
                    end
                    
                    local textLabel = billboard:FindFirstChild("HealthText")
                    if textLabel then
                        textLabel.Text = "HP: " .. math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
                        textLabel.TextColor3 = rainbowColor
                    end
                end
            end
        else
            clearHealthGuis()
        end

        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChild("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")

        if flyToggled and hrp and bodyVelocity and bodyGyro then
            bodyGyro.CFrame = Camera.CFrame
            local moveDirection = hum.MoveDirection
            local ySpeed = 0
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then ySpeed = flySpeed end
            bodyVelocity.Velocity = (Camera.CFrame.LookVector * (moveDirection.Magnitude > 0 and flySpeed or 0)) + Vector3.new(0, ySpeed, 0)
        end

        if runTabEnabled and hum then hum.WalkSpeed = customRunSpeed end
        if jumpPowerEnabled and hum then hum.JumpPower = customJumpPower end
        if bunnyHopEnabled and hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        if noclipEnabled then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
        if fullBrightEnabled then Lighting.Brightness = brightLevelValue Lighting.GlobalShadows = false end
        if fovEnabled then Camera.FieldOfView = fovValue end
    end)
end)

