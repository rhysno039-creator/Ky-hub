local function loadContentItems(categoryName)
    -- Hapus isi konten lama
    for _, child in ipairs(ContentArea:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    -- Simulasi daftar item fitur berdasarkan kategori di screenshot Anda
    local items = {}
    if categoryName == "Farm" then
        items = {"Auto farm", "Traps", "Eggs on the map", "Placing & hatching", "Drop point"}
    elseif categoryName == "Movement" then
        items = {"WalkSpeed Modifier", "JumpPower Modifier", "Infinite Jump", "Noclip", "Fly Mode"}
    elseif categoryName == "Egg X-ray" then
        items = {"X-Ray Common Eggs", "X-Ray Epic Eggs", "X-Ray Legendary", "Highlight Rare Eggs"}
    elseif categoryName == "Guard" then
        items = {"Anti-AFK", "Auto Reconnect", "Safe Zone Teleport", "Notification Alerts"}
    elseif categoryName == "Speed" then
        items = {"Super Speed Boost", "Instant Interact", "Fast Cooldown"}
    elseif categoryName == "Events" then
        items = {"Auto Claim Event Rewards", "Event Item Notifier", "Teleport to Event Area"}
    elseif categoryName == "Stats" then
        items = {"View Player Stats", "Export Data Logs", "Reset Character Stats"}
    else
        items = {"Feature 1", "Feature 2", "Feature 3"}
    end
    
    for i, itemName in ipairs(items) do
        local ItemFrame = Instance.new("Frame")
        ItemFrame.Parent = ContentArea
        ItemFrame.BackgroundColor3 = Color3.fromRGB(24, 29, 39)
        ItemFrame.Size = UDim2.new(1, -8, 0, 32)
        
        local ItemCorner = Instance.new("UICorner")
        ItemCorner.CornerRadius = UDim.new(0, 4)
        ItemCorner.Parent = ItemFrame
        
        local ItemText = Instance.new("TextLabel")
        ItemText.Parent = ItemFrame
        ItemText.BackgroundTransparency = 1
        ItemText.Position = UDim2.new(0, 10, 0, 0)
        ItemText.Size = UDim2.new(1, -30, 1, 0)
        ItemText.Font = Enum.Font.GothamMedium
        ItemText.Text = itemName
        ItemText.TextColor3 = Color3.fromRGB(210, 220, 235)
        ItemText.TextSize = 11
        ItemText.TextXAlignment = Enum.TextXAlignment.Left
        
        local ArrowText = Instance.new("TextLabel")
        ArrowText.Parent = ItemFrame
        ArrowText.BackgroundTransparency = 1
        ArrowText.Position = UDim2.new(1, -25, 0, 0)
        ArrowText.Size = UDim2.new(0, 20, 1, 0)
        ArrowText.Font = Enum.Font.GothamBold
        ArrowText.Text = ">"
        ArrowText.TextColor3 = Color3.fromRGB(150, 160, 180)
        ArrowText.TextSize = 12
    end
    
    ContentArea.CanvasSize = UDim2.new(0, 0, 0, (#items * 36) + 10)
end

local function createSidebarButton(name, order)
    local Btn = Instance.new("TextButton")
    Btn.Parent = Sidebar
    Btn.BackgroundColor3 = Color3.fromRGB(22, 27, 36)
    Btn.Size = UDim2.new(1, -6, 0, 28)
    Btn.Font = Enum.Font.GothamMedium
    Btn.Text = "  " .. name
    Btn.TextColor3 = Color3.fromRGB(180, 190, 210)
    Btn.TextSize = 11
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Btn.LayoutOrder = order
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 4)
    Corner.Parent = Btn
    
    Btn.MouseButton1Click:Connect(function()
        loadContentItems(name)
    end)
end

