local GetKeyBtn = Instance.new("TextButton")
GetKeyBtn.Size = UDim2.new(0.9, 0, 0, 40)
GetKeyBtn.Position = UDim2.new(0.05, 0, 0, 107)
GetKeyBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
