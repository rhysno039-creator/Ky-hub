-- 1. Lock Position Loop (Anti-Geter dengan Anchored)
task.spawn(function()
    while true do
        if lockPositionActive and lockedTreadmillCFrame and player.Character then
            pcall(function()
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    if not root.Anchored then
                        root.Anchored = true
                    end
                    root.CFrame = lockedTreadmillCFrame
                end
            end)
        end
        task.wait(0.2)
    end
end)

