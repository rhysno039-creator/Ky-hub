local currentTabContent = nil

local function createTabContent(tabName)
    if currentTabContent then currentTabContent:Destroy() end
    
    currentTabContent = Instance.new("Frame")
    currentTabContent.Parent = ContentArea
    currentTabContent.BackgroundTransparency = 1
    currentTabContent.Size = UDim2.new(1, 0, 1, 0)
    
    if tabName == "Info Hub" then
        -- ANGKA 2: Penjelasan Fitur + Live Uptime & Ping
        local InfoBox = Instance.new("Frame")
        InfoBox.Parent = currentTabContent
        InfoBox.BackgroundColor3 = Color3.fromRGB(18, 24, 36)
        InfoBox.Position = UDim2.new(0, 0, 0, 5)
        InfoBox.Size = UDim2.new(0, 220, 0, 330)
        
        local BoxCorner = Instance.new("UICorner")
        BoxCorner.CornerRadius = UDim.new(0, 6)
        BoxCorner.Parent = InfoBox
        
        local InfoText = Instance.new("TextLabel")
        InfoText.Parent = InfoBox
        InfoText.BackgroundTransparency = 1
        InfoText.Position = UDim2.new(0, 12, 0, 12)
        InfoText.Size = UDim2.new(1, -24, 1, -24)
        InfoText.Font = Enum.Font.GothamBold
        InfoText.Text = "Welcome KYZEN\nKYZEN IS BACK\n\nStatus: 28229 members\n001 online\n\nVersion: v2.1.0\n\nUptime: 00h 00m 00s\nPing: 0 ms"
        InfoText.TextColor3 = Color3.fromRGB(200, 230, 255)
        InfoText.TextSize = 12
        InfoText.TextXAlignment = Enum.TextXAlignment.Left
        InfoText.TextYAlignment = Enum.TextYAlignment.Top
        InfoText.TextWrapped = true

        -- Live Uptime & Ping Loop
        task.spawn(function()
            local startTime = tick()
            while InfoText and InfoText.Parent do
                local currentTime = tick() - startTime
                local hours = math.floor(currentTime / 3600)
                local minutes = math.floor((currentTime % 3600) / 60)
                local seconds = math.floor(currentTime % 60)
                
                local pingVal = 0
                pcall(function()
                    pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
                end)
                
                InfoText.Text = string.format(
                    "Welcome KYZEN\nKYZEN IS BACK\n\nStatus: 28229 members\n001 online\n\nVersion: v2.1.0\n\nUptime: %02dh %02dm %02ds\nPing: %d ms",
                    hours, minutes, seconds, pingVal
                )
                task.wait(1)
            end
        end)

        -- ANGKA 3: Logo / Gambar Saturnus di Kanan Info (Asset ID Planet Diperbarui)
        local SaturnBox = Instance.new("Frame")
        SaturnBox.Parent = currentTabContent
        SaturnBox.BackgroundColor3 = Color3.fromRGB(18, 24, 36)
        SaturnBox.Position = UDim2.new(0, 230, 0, 5)
        SaturnBox.Size = UDim2.new(0, 220, 0, 330)
        
        local SaturnBoxCorner = Instance.new("UICorner")
        SaturnBoxCorner.CornerRadius = UDim.new(0, 6)
        SaturnBoxCorner.Parent = SaturnBox
        
        local SaturnCard = Instance.new("ImageLabel")
        SaturnCard.Parent = SaturnBox
        SaturnCard.BackgroundTransparency = 1
        SaturnCard.Position = UDim2.new(0, 10, 0, 10)
        SaturnCard.Size = UDim2.new(1, -20, 1, -20)
        SaturnCard.Image = "rbxassetid://6034295172" -- Asset ID Ikon Tata Surya/Planet Roblox
        SaturnCard.ScaleType = Enum.ScaleType.Fit

    else
        -- Template Kosong Untuk Menu Lainnya
        local EmptyBox = Instance.new("Frame")
        EmptyBox.Parent = currentTabContent
        EmptyBox.BackgroundColor3 = Color3.fromRGB(18, 24, 36)
        EmptyBox.Position = UDim2.new(0, 0, 0, 5)
        EmptyBox.Size = UDim2.new(0, 450, 0, 330)
        
        local EmptyCorner = Instance.new("UICorner")
        EmptyCorner.CornerRadius = UDim.new(0, 6)
        EmptyCorner.Parent = EmptyBox
        
        local EmptyText = Instance.new("TextLabel")
        EmptyText.Parent = EmptyBox
        EmptyText.BackgroundTransparency = 1
        EmptyText.Size = UDim2.new(1, 0, 1, 0)
        EmptyText.Font = Enum.Font.GothamBold
        EmptyText.Text = "--- " .. tabName .. " MENU ---\n\n(Fitur akan segera ditambahkan di sini)"
        EmptyText.TextColor3 = Color3.fromRGB(0, 220, 255)
        EmptyText.TextSize = 14
        EmptyText.TextWrapped = true
    end
end

-- Fungsi Pembuat Tombol Menu Kiri
local function createMenuButton(name, order)
    local Btn = Instance.new("TextButton")
    Btn.Parent = Sidebar
    Btn.BackgroundColor3 = Color3.fromRGB(22, 32, 48)
    Btn.Size = UDim2.new(0, 115, 0, 35)
    Btn.Font = Enum.Font.GothamBold
    Btn.Text = name
    Btn.TextColor3 = Color3.fromRGB(0, 220, 255)
    Btn.TextSize = 11
    Btn.LayoutOrder = order
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 4)
    Corner.Parent = Btn
    
    Btn.MouseButton1Click:Connect(function()
        createTabContent(name)
    end)
end

