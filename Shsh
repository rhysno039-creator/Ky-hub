    end
})

RunService.RenderStepped:Connect(function()
    if _G.SpeedEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = _G.SpeedVal
    end
end)

PlayerTab:Toggle({
    Title = "Status Jump Power On/Off",
    Default = false,
    Callback = function(Value)
        _G.JumpEnabled = Value
    end
})

PlayerTab:Input({
    Title = "Jump Power (0 - 676)",
    Default = "50",
    Placeholder = "Masukkan angka jump...",
    Callback = function(Text)
        local num = tonumber(Text)
        if num then _G.JumpVal = num end
    end
})

RunService.RenderStepped:Connect(function()
    if _G.JumpEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.UseJumpPower = true
        LocalPlayer.Character.Humanoid.JumpPower = _G.JumpVal
    end
end)

PlayerTab:Toggle({
