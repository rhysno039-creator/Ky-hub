Tabs.ESP:Section({ Title = "ESP & Effects" })

Tabs.ESP:Toggle({
    Title = "Rainbow Tracers",
    Default = false,
    Callback = function(state)
        rainbowTracersEnabled = state
        if not state then removeTracers() end
    end
})

Tabs.ESP:Toggle({
    Title = "Skeleton ESP (Box / Highlight Style)",
    Default = false,
    Callback = function(state)
        rainbowSkeletonEnabled = state
        if not state then clearSkeletonGuis() end
    end
})

Tabs.ESP:Section({ Title = "Hitbox Expander & Box ESP" })

Tabs.ESP:Toggle({
    Title = "Hitbox Expander (Rainbow)",
    Default = false,
    Callback = function(state)
        hitboxEnabled = state
        if not state then
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.CanCollide = true
                end
            end
        end
    end
})

Tabs.ESP:Input({
    Title = "Hitbox Size Value",
    Default = "5",
    Placeholder = "Enter size...",
    Callback = function(value)
        local num = tonumber(value)
        if num then hitboxSizeValue = num end
    end
})

Tabs.ESP:Toggle({
    Title = "ESP Box (With Name & Distance)",
    Default = false,
    Callback = function(state)
        espEnabled = state
